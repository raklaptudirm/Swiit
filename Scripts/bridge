#!/bin/bash
# Regenerates the bridges in Sources/Swiit/SwiftLibraryBridges/Generated from the symbol
# graphs of the standard library, Foundation, swift-system and Swiit's own
# modules. Run it after changing swiit-bridge, the Swift toolchain or
# swift-system. A graph is read on the platform it's made on, so each
# platform's members are kept in Bridges/<platform>, and what's bridged is
# what all the platforms there have: CI makes Linux's (see
# .github/workflows/ci.yml), and a member only one has can't break the other.
#
# CI's Xcode (the latest stable) may be older than the one on a developer's machine, and its SDK
# documents and lists some members differently: when CI says the bridges are out of date, commit the
# files its job kept (the artifact `bridges-macos`) rather than the ones made here.
#
# A client with bridges of its own (a host may have them) runs the generator
# itself: `swift run --package-path <Swiit> -c release swiit-bridge --help`.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "$(uname)" = Darwin ]; then platform=macos; else platform=linux; fi
graphs=$(mktemp -d)
trap 'rm -rf "$graphs"' EXIT
# What the generator left out, and why, one file a module (see `--report`); not kept in git.
left_out=.build/bridge-left-out
mkdir -p "$left_out"

# Not the whole package: the glue being made may be what stops it from building.
swift build --target SystemPackage
swift build --product swiit-bridge
machine=$(uname -m)
built=$(swift build --show-bin-path)

# Writes a module's symbol graph into $graphs. SystemPackage is found among
# what `swift build` built, with the C module it imports.
graph() {
    local search=(-I "$built" -I "$built/Modules" -I .build/checkouts/swift-system/Sources/CSystem/include)
    if [ "$(uname)" = Darwin ]; then
        "$(xcrun --find swift-symbolgraph-extract)" -module-name "$1" -target "$machine-apple-macosx14.0" \
            -sdk "$(xcrun --show-sdk-path)" "${search[@]}" -output-dir "$graphs"
    else
        swift-symbolgraph-extract -module-name "$1" -target "$machine-unknown-linux-gnu" "${search[@]}" -output-dir "$graphs"
    fi
}

# Other modules that extend a module's types, whose graphs are read with it.
extensions() {
    case "$1" in
        Swift) echo "_StringProcessing" ;;
    esac
}
# A module's types can be defined in a module it re-exports, which some
# platforms don't have: Foundation's Date is FoundationEssentials' on Linux.
# Their graphs are read with it, and what adds to them is too.
reexports() {
    case "$1" in Foundation) echo "FoundationEssentials" ;; esac
}
output() {
    case "$1" in
        Swift) echo StandardLibrary ;;
        *) echo "$1" ;;
    esac
}
# What the output is called (`<Name>Bridge`), and the types of the module it bridges.
bridge_name() {
    case "$1" in
        Swift) echo StandardLibrary ;;
        SystemPackage) echo System ;;
        *) echo "$1" ;;
    esac
}
types() {
    case "$1" in
        Swift) echo String Substring Character Unicode.Scalar Int Double Bool Array ArraySlice Set \
            Dictionary Optional Range ClosedRange ;;
        # FilePath.Root is left out: the standard library's FilePath (SE-0529) calls it Anchor.
        SystemPackage) echo FilePath FilePath.Component FilePath.ComponentView ;;
        # Foundation's types Swiit holds as Swift's: a date.
        Foundation) echo Date AttributedString ;;
    esac
}

# Swift's lazy sequence types that a member gives, held as the arrays they give; each ends.
as_array() {
    case "$1" in
        Swift) echo Zip2Sequence LazySequence EnumeratedSequence ReversedCollection PrefixSequence \
            DropWhileSequence DropFirstSequence ;;
    esac
}
# The top-level functions of a module that are bridged.
functions() {
    case "$1" in Swift) echo zip ;; esac
}

for module in Swift SystemPackage Foundation; do
    graph "$module"
    extra=()
    hosts=("$module")
    for host in $(reexports "$module"); do
        graph "$host" || true
        if [ -f "$graphs/$host.symbols.json" ]; then
            hosts+=("$host")
            extra+=("$graphs/$host.symbols.json")
        fi
    done
    for other in $(extensions "$module"); do
        graph "$other"
        for host in "${hosts[@]}"; do
            file="$graphs/$other@$host.symbols.json"
            if [ -f "$file" ]; then extra+=("$file"); fi
        done
    done
    platforms=(--manifest "Bridges/$platform/$module.json" --report "$left_out/$module.tsv")
    for other in macos linux; do
        manifest="Bridges/$other/$module.json"
        if [ "$other" != "$platform" ] && [ -f "$manifest" ]; then platforms+=(--also "$manifest"); fi
    done
    # These are Swiit's own files, so they neither import it nor are public; a client with bridges
    # of its own leaves these out.
    platforms+=(--name "$(bridge_name "$module")" --access internal --in-module Swiit)
    for type in $(types "$module"); do platforms+=(--type "$type"); done
    for type in $(as_array "$module"); do platforms+=(--as-array "$type"); done
    for function in $(functions "$module"); do platforms+=(--function "$function"); done
    swift run -c release swiit-bridge "$graphs/$module.symbols.json" \
        "Sources/Swiit/SwiftLibraryBridges/Generated/$(output "$module").swift" ${extra[@]+"${extra[@]}"} "${platforms[@]}"
done

# The gaps by kind, most common first: what closing each in the generator would bring in.
echo "Left out, by kind (details in $left_out):"
tail -q -n +2 "$left_out"/*.tsv | cut -f1 | sort | uniq -c | sort -rn | head -15
